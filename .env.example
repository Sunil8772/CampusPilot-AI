# Synthetic role selector for local buildathon demos only.
# Never enable this for a public or production deployment without real authentication.
CAMPUSPILOT_DEMO_MODE=true

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local or hosted PostgreSQL connection
DATABASE_URL=postgresql://username:password@localhost:5432/campuspilot
